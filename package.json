{
  "name": "nutritual",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "bun --env-file=.env.local run --parallel --filter './apps/*' dev",
    "db:check": "bun --env-file=.env.local run --filter server db:check",
    "lint": "bun run --parallel --filter '*' lint",
    "typecheck": "bun run --parallel --filter '*' typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun run --filter server test && bun run --filter mobile test"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "catalog:tooling"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "catalogs": {
    "tooling": {
      "@oxlint/plugins": "1.89.0",
      "oxfmt": "^0.74.0",
      "oxlint": "1.89.0",
      "oxlint-plugin-react-doctor": "^0.9.18"
    }
  }
}
