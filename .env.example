# Pooled Postgres connection used by `bun run db:check`.
DATABASE_URL=
# Direct Postgres connection for migrations and administrative work.
DATABASE_URL_UNPOOLED=
# Branch selected by the Neon CLI.
NEON_BRANCH=development
# Server origin used by Better Auth and the Expo app.
BETTER_AUTH_URL=
# Generate with `bunx auth@1.7.13 secret`; keep this value private.
BETTER_AUTH_SECRET=
# Expo app URL for the Bun server, also used for the development relay.
EXPO_PUBLIC_SERVER_URL=
# Temporary one-account provisioning values. Remove them after provisioning.
AUTH_PROVISION_EMAIL=
AUTH_PROVISION_PASSWORD=
