# Pooled Postgres connection used by `bun run db:check` and pairing metadata.
# Set sslmode=verify-full explicitly. pg v9 will give sslmode=require weaker
# libpq semantics instead of the verify-full behavior used by pg today.
DATABASE_URL=
# Direct Postgres connection for migrations and administrative work.
DATABASE_URL_UNPOOLED=
# Branch selected by the Neon CLI.
NEON_BRANCH=development

# Neon Managed Auth issuer URL.
NEON_AUTH_BASE_URL=
# Public HTTPS origin of the Bun server, used for OAuth callbacks and MCP.
PUBLIC_BASE_URL=
# Public OAuth client ID registered for the native mobile app.
MOBILE_OAUTH_CLIENT_ID=

# Server origin reachable from the iPhone. Use the same URL as PUBLIC_BASE_URL
# for the public ChatGPT pairing flow.
EXPO_PUBLIC_SERVER_URL=
# These values match NEON_AUTH_BASE_URL and MOBILE_OAUTH_CLIENT_ID.
EXPO_PUBLIC_NEON_AUTH_BASE_URL=
EXPO_PUBLIC_MOBILE_OAUTH_CLIENT_ID=
