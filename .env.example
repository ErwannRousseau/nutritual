# Pooled Postgres connection used by `bun run db:check`.
DATABASE_URL=
# Direct Postgres connection for migrations and administrative work.
DATABASE_URL_UNPOOLED=
# Branch selected by the Neon CLI.
NEON_BRANCH=development
# Managed Better Auth endpoint used by `bun run auth:check`.
NEON_AUTH_BASE_URL=
# Public keys endpoint for future server-side JWT verification.
NEON_AUTH_JWKS_URL=
